# ------------------------------------------------------------
# Melos / Monorepo Specific
# ------------------------------------------------------------
.melos_tool/
melos_logs/
**/pubspec_overrides.yaml

# Ignore pubspec.lock in shared packages (libraries), but keep them for apps
packages/**/pubspec.lock

# ------------------------------------------------------------
# Global System & IDE Files (Recursive)
# ------------------------------------------------------------
# These patterns use **/ to ensure they are ignored in every sub-folder
**/.DS_Store
**/.history
**/.svn/
**/.atom/
**/.idea/
**/.vscode/
**/*.iml
**/*.ipr
**/*.iws
**/*.swp
**/*.class
**/*.log
**/*.pyc
**/migrate_working_dir/
# Firebase configs contain secrets - never commit
**/google-services.json
**/GoogleService-Info.plist

# ------------------------------------------------------------
# Global Flutter/Dart Build Artifacts (Recursive)
# ------------------------------------------------------------
**/build/
**/.dart_tool/
**/.flutter-plugins
**/.flutter-plugins-dependencies
**/.pub-cache/
**/.pub/
**/doc/api/
**/coverage/

# ------------------------------------------------------------
# Platform Tooling Artifacts (Recursive)
# ------------------------------------------------------------
# Gradle / Android NDK build caches
**/.gradle/
**/captures/
**/.cxx/
# Kotlin 2.x compiler session data
**/.kotlin/
# Xcode user-specific state
**/xcuserdata/
**/DerivedData/
# Flutter ephemeral dirs (desktop/macOS)
**/ephemeral/

# ------------------------------------------------------------
# Generated Dart Code (Recursive)
# ------------------------------------------------------------
**/*.freezed.dart
**/*.g.dart
**/*.g.part.dart
**/*.mocks.dart
# Flutter gen-l10n output (any output-class name)
**/l10n/*_localizations.dart
**/l10n/*_localizations_*.dart
**/untranslated_messages.txt

# ------------------------------------------------------------
# Global Mobile Artifacts (Recursive Safety)
# ------------------------------------------------------------
**/android/.gradle
**/android/captures/
**/android/**/*.jks
**/android/**/*.keystore
**/android/local.properties
**/android/key.properties
**/ios/.generated/
**/ios/Pods/
# Generated plugin registrants (regenerated by flutter pub get)
**/generated_plugin_registrant.*
**/GeneratedPluginRegistrant.*
**/generated_plugins.cmake
